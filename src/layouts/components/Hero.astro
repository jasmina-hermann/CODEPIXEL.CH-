---
import AnimatedButton from "@/components/AnimatedButton.astro";
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";
interface Props {
  data: any;
}
const { data } = Astro.props;
const rotatingWords: string[] = data.rotating_words ?? [];
const rotatingPrefix: string = data.rotating_prefix ?? "";
---

<section class="cp-hero overflow-hidden relative">
  <!-- ========== TITELBILD: Hintergrund ========== -->
  <div class="cp-hero-bg" aria-hidden="true">
    <canvas class="cp-hero-pixels" data-hero-pixels></canvas>
    <div class="cp-hero-grid"></div>
    <div class="cp-hero-glow cp-hero-glow--a"></div>
    <div class="cp-hero-glow cp-hero-glow--b"></div>
    <div class="cp-hero-glow cp-hero-glow--c"></div>
    <div class="cp-hero-beam"></div>
    <div class="cp-hero-spot" data-hero-spot></div>
    <div class="cp-hero-horizon"></div>
  </div>

  <div class="h-full w-px bg-light/8 absolute top-0 left-1/2 -translate-x-1/2 z-1">
  </div>

  <div class="main-container relative z-2">
    <div class="container px-0 relative">
      <div class="container-padding-y pb-16 px-0 relative">
        <div class="flex justify-center items-center flex-col text-center px-4">
          <!-- BADGE -->
          {
            data.badge?.enable && (
              <div
                id="hero-badge"
                class="bg-gradient-secondary p-px rounded-full mb-2"
              >
                <div class="px-1.5 py-1.75 bg-gradient-black-grid rounded-full flex items-center gap-2.5">
                  {data.badge.images?.length > 0 && (
                    <ul class="flex">
                      {data.badge.images.map((src: string) => (
                        <li class="border border-secondary rounded-full -mr-2 last:mr-0 size-6">
                          <ImageMod
                            src={src}
                            alt=""
                            width={24}
                            height={24}
                            class="rounded-full object-cover size-full"
                          />
                        </li>
                      ))}
                    </ul>
                  )}
                  <span class="cp-live-dot" aria-hidden="true"></span>
                  <p class="codepixel-badge-label">{data.badge.label}</p>
                </div>
              </div>
            )
          }
          <!-- TITLE -->
          <h1 id="hero-title" class="hero-text mb-4">
            <span set:html={markdownify(data.title).__html} />
            {
              rotatingWords.length > 0 && (
                <span class="cp-rotator-line">
                  {rotatingPrefix && <span>{rotatingPrefix} </span>}
                  <span class="cp-rotator" data-rotator>
                    {rotatingWords.map((word, i) => (
                      <span
                        class:list={[
                          "cp-rotator-word heading-script-accent",
                          { "is-active": i === 0 },
                        ]}
                        aria-hidden={i === 0 ? undefined : "true"}
                      >
                        {word}
                      </span>
                    ))}
                  </span>
                </span>
              )
            }
          </h1>
          <!-- CONTENT -->
          <p id="hero-content" class="text-lg sm:w-3/5">
            {data.content}
          </p>
          <!-- BUTTONS -->
          <div
            id="hero-buttons"
            class="mt-10 flex items-center gap-5 flex-wrap justify-center"
          >
            {
              data.button_dark?.enable && (
                <AnimatedButton
                  classNames="btn btn-dark"
                  href={data.button_dark?.link || "/"}
                >
                  {data.button_dark?.label}
                </AnimatedButton>
              )
            }
            {
              data.button_primary?.enable && (
                <AnimatedButton
                  classNames="btn btn-primary"
                  href={data.button_primary?.link || "/"}
                >
                  {data.button_primary?.label}
                </AnimatedButton>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     TITELBILD – Hintergrund
     ========================================================= */
  .cp-hero {
    isolation: isolate;
  }

  .cp-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Pixel-Feld (Canvas) – Mitte bleibt ruhig, damit der Text gut lesbar ist */
  .cp-hero-pixels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(ellipse 46% 52% at 50% 46%, transparent 0%, transparent 38%, #000 82%);
    mask-image: radial-gradient(ellipse 46% 52% at 50% 46%, transparent 0%, transparent 38%, #000 82%);
    opacity: 0.95;
  }

  /* Feines Raster */
  .cp-hero-grid {
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(rgba(255, 152, 0, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 152, 0, 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 40%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 75% 70% at 50% 40%, #000 20%, transparent 78%);
    animation: cpGridDrift 18s linear infinite;
  }

  /* Leuchtende Farbwolken in Codepixel-Farben */
  .cp-hero-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(90px);
    mix-blend-mode: screen;
    will-change: transform;
  }
  .cp-hero-glow--a {
    width: 46rem;
    height: 22rem;
    left: 50%;
    top: 8%;
    margin-left: -23rem;
    background: radial-gradient(closest-side, rgba(255, 152, 0, 0.38), transparent);
    animation: cpGlowA 14s ease-in-out infinite;
  }
  .cp-hero-glow--b {
    width: 26rem;
    height: 26rem;
    left: -6rem;
    bottom: -8rem;
    background: radial-gradient(closest-side, rgba(255, 208, 0, 0.22), transparent);
    animation: cpGlowB 17s ease-in-out infinite;
  }
  .cp-hero-glow--c {
    width: 30rem;
    height: 24rem;
    right: -8rem;
    top: 18%;
    background: radial-gradient(closest-side, rgba(243, 106, 0, 0.26), transparent);
    animation: cpGlowC 20s ease-in-out infinite;
  }

  /* Lichtstrahl, der langsam über das Bild wandert */
  .cp-hero-beam {
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 22%;
    left: -30%;
    background: linear-gradient(90deg, transparent, rgba(255, 208, 0, 0.07), transparent);
    transform: skewX(-18deg);
    animation: cpBeam 9s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  /* Licht folgt der Maus */
  .cp-hero-spot {
    position: absolute;
    width: 34rem;
    height: 34rem;
    left: 0;
    top: 0;
    margin: -17rem 0 0 -17rem;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(255, 173, 22, 0.13), transparent);
    transform: translate3d(50vw, 40%, 0);
    transition: opacity 0.6s ease;
    opacity: 0;
  }
  .cp-hero-spot.is-on {
    opacity: 1;
  }

  /* Leuchtende Horizontlinie unten */
  .cp-hero-horizon {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(70rem, 92%);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(255, 152, 0, 0.7), rgba(255, 208, 0, 0.95), rgba(255, 152, 0, 0.7), transparent);
    box-shadow: 0 0 22px 2px rgba(255, 152, 0, 0.35);
  }
  .cp-hero-horizon::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 60%;
    height: 9rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 100% at 50% 100%, rgba(255, 152, 0, 0.16), transparent 70%);
  }

  /* =========================================================
     Badge & Titel (bestehend)
     ========================================================= */
  .codepixel-badge-label {
    padding: 0.05rem 1rem 0.05rem 0;
    color: #ffd000;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .cp-live-dot {
    width: 8px;
    height: 8px;
    margin-left: 0.85rem;
    border-radius: 999px;
    background: #ffd000;
    animation: cpHeroPing 2s ease-out infinite;
  }

  /* Farbiger Verlauf für markierte Wörter (z. B. ==Kunden==) */
  #hero-title :global(mark:not(.heading-script-accent)) {
    color: transparent;
    background: linear-gradient(110deg, #ffd000 0%, #ff9800 58%, #f36a00 100%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  #hero-title,
  #hero-content {
    text-shadow: 0 2px 24px rgba(5, 6, 8, 0.85);
  }

  /* ---------- Wechselnde Wörter in Schnürlischrift ---------- */
  .cp-rotator-line {
    display: block;
    margin-top: 0.3em;
  }

  .cp-rotator {
    display: inline-grid;
    vertical-align: baseline;
    text-align: left;
  }

  .cp-rotator-word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: rotate(-2deg) translateY(0.45em);
    filter: blur(6px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.55s ease;
  }

  .cp-rotator-word.is-active {
    opacity: 1;
    transform: rotate(-2deg) translateY(0.04em);
    filter: blur(0);
  }

  .cp-rotator-word.is-leaving {
    opacity: 0;
    transform: rotate(-2deg) translateY(-0.45em);
    filter: blur(6px);
  }

  /* Handy: Wort steht unter "Mit" und bricht nie über den Rand */
  @media (max-width: 640px) {
    .cp-rotator-line {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 100%;
    }

    .cp-rotator {
      text-align: center;
      max-width: 100%;
    }

    .cp-rotator-word {
      font-size: 1.15em;
      white-space: normal;
      text-align: center;
    }

    .cp-hero-glow--a {
      width: 26rem;
      margin-left: -13rem;
    }

    .cp-hero-pixels {
      -webkit-mask-image: radial-gradient(ellipse 70% 40% at 50% 45%, transparent 30%, #000 90%);
      mask-image: radial-gradient(ellipse 70% 40% at 50% 45%, transparent 30%, #000 90%);
      opacity: 0.7;
    }
  }

  /* =========================================================
     Animationen (laufen immer)
     ========================================================= */
  @keyframes cpHeroPing {
    0% { box-shadow: 0 0 0 0 rgba(255, 208, 0, 0.6); }
    100% { box-shadow: 0 0 0 9px rgba(255, 208, 0, 0); }
  }
  @keyframes cpGridDrift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 0 44px, 44px 0; }
  }
  @keyframes cpGlowA {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(3rem, 1.5rem, 0) scale(1.12); }
  }
  @keyframes cpGlowB {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(5rem, -3rem, 0); }
  }
  @keyframes cpGlowC {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-4rem, 3rem, 0) scale(0.9); }
  }
  @keyframes cpBeam {
    0% { left: -30%; }
    70%, 100% { left: 120%; }
  }
</style>

<script>
  import { animateMini as animate } from "motion";

  function initHero() {
    const smooth = { ease: "easeInOut" as const };
    const items: [string, Record<string, string[]>, number, number][] = [
      ["hero-badge", { opacity: ["0", "1"], transform: ["translateY(-20px)", "translateY(0)"] }, 0.5, 0.2],
      ["hero-title", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.8, 0.3],
      ["hero-content", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.5],
      ["hero-buttons", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.6],
    ];
    items.forEach(([id, keyframes, duration, delay]) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.opacity = "0";
      animate(el, keyframes, { ...smooth, duration, delay });
    });
  }

  let rotatorTimer: number | undefined;

  function initRotator() {
    window.clearInterval(rotatorTimer);
    const rotator = document.querySelector<HTMLElement>("[data-rotator]");
    if (!rotator) return;
    const words = Array.from(
      rotator.querySelectorAll<HTMLElement>(".cp-rotator-word"),
    );
    if (words.length < 2) return;
    let index = 0;
    rotatorTimer = window.setInterval(() => {
      const current = words[index];
      index = (index + 1) % words.length;
      const next = words[index];
      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      current.setAttribute("aria-hidden", "true");
      next.classList.remove("is-leaving");
      next.classList.add("is-active");
      next.removeAttribute("aria-hidden");
      window.setTimeout(() => current.classList.remove("is-leaving"), 600);
    }, 2400);
  }

  /* ---------- Pixel-Feld: Pixel leuchten in Codepixel-Farben auf ---------- */
  let pixelCleanup: (() => void) | undefined;

  function initPixels() {
    pixelCleanup?.();
    const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-pixels]");
    const section = canvas?.closest<HTMLElement>(".cp-hero");
    const spot = document.querySelector<HTMLElement>("[data-hero-spot]");
    if (!canvas || !section) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const COLORS = ["255,152,0", "255,208,0", "255,173,22", "243,106,0"];
    const CELL = 22;
    const GAP = 3;
    let w = 0;
    let h = 0;
    let cols = 0;
    let rows = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;
    let mouseX = -9999;
    let mouseY = -9999;

    type Px = { c: number; r: number; life: number; max: number; color: string; peak: number };
    let pixels: Px[] = [];

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = section.clientWidth;
      h = section.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CELL);
      rows = Math.ceil(h / CELL);
    };

    const spawn = (c?: number, r?: number, strong = false): Px => ({
      c: c ?? Math.floor(Math.random() * cols),
      r: r ?? Math.floor(Math.random() * rows),
      life: 0,
      max: strong ? 50 + Math.random() * 30 : 90 + Math.random() * 160,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      peak: strong ? 0.9 : 0.15 + Math.random() * 0.45,
    });

    const target = () => Math.round((cols * rows) / (w < 640 ? 40 : 26));

    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // Ruhige Grund-Pixel
      ctx.fillStyle = "rgba(255,152,0,0.035)";
      for (let r = 0; r < rows; r += 1) {
        for (let c = (r % 2); c < cols; c += 2) {
          ctx.fillRect(c * CELL + GAP, r * CELL + GAP, CELL - GAP * 2, CELL - GAP * 2);
        }
      }

      while (pixels.length < target()) pixels.push(spawn());

      // Pixel in der Nähe der Maus leuchten auf
      if (mouseX > -1000 && Math.random() < 0.55) {
        const c = Math.floor((mouseX + (Math.random() - 0.5) * 160) / CELL);
        const r = Math.floor((mouseY + (Math.random() - 0.5) * 160) / CELL);
        if (c >= 0 && r >= 0 && c < cols && r < rows) pixels.push(spawn(c, r, true));
      }

      pixels = pixels.filter((p) => {
        p.life += 1;
        const t = p.life / p.max;
        if (t >= 1) return false;
        const a = Math.sin(t * Math.PI) * p.peak;
        const x = p.c * CELL + GAP;
        const y = p.r * CELL + GAP;
        const s = CELL - GAP * 2;
        ctx.fillStyle = `rgba(${p.color},${a.toFixed(3)})`;
        ctx.fillRect(x, y, s, s);
        if (a > 0.6) {
          ctx.shadowColor = `rgba(${p.color},${a.toFixed(3)})`;
          ctx.shadowBlur = 14;
          ctx.fillRect(x + 2, y + 2, s - 4, s - 4);
          ctx.shadowBlur = 0;
        }
        return true;
      });

      if (visible) raf = requestAnimationFrame(draw);
    };

    const onMove = (e: PointerEvent) => {
      const rect = section.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      if (spot) {
        spot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        spot.classList.add("is-on");
      }
    };
    const onLeave = () => {
      mouseX = -9999;
      mouseY = -9999;
      spot?.classList.remove("is-on");
    };

    const io = new IntersectionObserver(([entry]) => {
      const was = visible;
      visible = entry.isIntersecting;
      if (visible && !was) raf = requestAnimationFrame(draw);
      if (!visible) cancelAnimationFrame(raf);
    });

    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(section);
    io.observe(section);
    section.addEventListener("pointermove", onMove);
    section.addEventListener("pointerleave", onLeave);
    raf = requestAnimationFrame(draw);

    pixelCleanup = () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      section.removeEventListener("pointermove", onMove);
      section.removeEventListener("pointerleave", onLeave);
    };
  }

  document.addEventListener("astro:page-load", () => {
    initHero();
    initRotator();
    initPixels();
  });
</script>
