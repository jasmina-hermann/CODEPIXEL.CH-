---
import AnimatedButton from "@/components/AnimatedButton.astro";
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";
interface Props {
  data: any;
}
const { data } = Astro.props;
const rotatingWords: string[] = data.rotating_words ?? [];
const rotatingPrefix: string = data.rotating_prefix ?? "";
---

<section class="cp-hero overflow-hidden relative">
  <!-- ========== TITELBILD: Hintergrund ========== -->
  <div class="cp-hero-bg" aria-hidden="true">
    <canvas class="cp-hero-pixels" data-hero-pixels></canvas>
    <div class="cp-hero-grid"></div>
    <div class="cp-hero-glow cp-hero-glow--a"></div>
    <div class="cp-hero-glow cp-hero-glow--b"></div>
    <div class="cp-hero-glow cp-hero-glow--c"></div>
    <div class="cp-hero-beam"></div>
    <div class="cp-hero-spot" data-hero-spot></div>
    <div class="cp-hero-horizon"></div>
  </div>

  <div class="h-full w-px bg-light/8 absolute top-0 left-1/2 -translate-x-1/2 z-1">
  </div>

  <div class="main-container relative z-2">
    <div class="container px-0 relative">
      <!-- ========== Schwebende Karten (nur grosse Bildschirme) ========== -->
      <div class="cp-float-layer" aria-hidden="true">
        <!-- Karte 1: Webseite live -->
        <div class="cp-float cp-float--site" style="--fd:0s; --fx:-6px">
          <div class="cp-fcard">
            <div class="cp-fbar"><span></span><span></span><span></span><em>ihre-firma.ch</em></div>
            <div class="cp-fsite">
              <i class="cp-fsk w90"></i>
              <i class="cp-fsk w60"></i>
              <div class="cp-fsite-row"><b></b><b></b><b></b></div>
            </div>
            <div class="cp-fstatus"><span class="cp-fcheck">✓</span> Webseite live</div>
          </div>
        </div>

        <!-- Karte 2: Mehr Anfragen -->
        <div class="cp-float cp-float--chart" style="--fd:-2.4s; --fx:6px">
          <div class="cp-fcard">
            <p class="cp-flabel">Anfragen</p>
            <p class="cp-fvalue">steigend <span>↗</span></p>
            <svg class="cp-fspark" viewBox="0 0 160 56" preserveAspectRatio="none">
              <defs>
                <linearGradient id="cpSparkFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#ff9800" stop-opacity="0.45"></stop>
                  <stop offset="100%" stop-color="#ff9800" stop-opacity="0"></stop>
                </linearGradient>
                <linearGradient id="cpSparkLine" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#ff9800"></stop>
                  <stop offset="100%" stop-color="#ffd000"></stop>
                </linearGradient>
              </defs>
              <path class="cp-fspark-area" d="M0 48 L20 44 L40 46 L60 36 L80 38 L100 26 L120 22 L140 12 L160 6 L160 56 L0 56 Z" fill="url(#cpSparkFill)"></path>
              <path class="cp-fspark-line" d="M0 48 L20 44 L40 46 L60 36 L80 38 L100 26 L120 22 L140 12 L160 6" fill="none" stroke="url(#cpSparkLine)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle class="cp-fspark-dot" cx="160" cy="6" r="3.5" fill="#ffd000"></circle>
            </svg>
          </div>
        </div>

        <!-- Karte 3: Code -->
        <div class="cp-float cp-float--code" style="--fd:-1.2s; --fx:5px">
          <div class="cp-fcard cp-fcard--code">
            <p><b>const</b> ablauf = <u>automatisch</u>();</p>
            <p><b>await</b> kunde.<u>gewinnen</u>();</p>
            <p class="cp-fcomment">// weniger Aufwand ✓<span class="cp-fcaret"></span></p>
          </div>
        </div>

        <!-- Karte 4: Projekt-Schritte -->
        <div class="cp-float cp-float--steps" style="--fd:-3.4s; --fx:-5px">
          <div class="cp-fcard">
            <p class="cp-flabel">Ihr Projekt</p>
            <ul class="cp-fsteps">
              <li class="done"><span></span>Analyse</li>
              <li class="done"><span></span>Design</li>
              <li class="run"><span></span>Umsetzung</li>
              <li><span></span>Launch</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="container-padding-y pb-16 px-0 relative">
        <div class="flex justify-center items-center flex-col text-center px-4">
          <!-- BADGE -->
          {
            data.badge?.enable && (
              <div
                id="hero-badge"
                class="bg-gradient-secondary p-px rounded-full mb-2"
              >
                <div class="px-1.5 py-1.75 bg-gradient-black-grid rounded-full flex items-center gap-2.5">
                  {data.badge.images?.length > 0 && (
                    <ul class="flex">
                      {data.badge.images.map((src: string) => (
                        <li class="border border-secondary rounded-full -mr-2 last:mr-0 size-6">
                          <ImageMod
                            src={src}
                            alt=""
                            width={24}
                            height={24}
                            class="rounded-full object-cover size-full"
                          />
                        </li>
                      ))}
                    </ul>
                  )}
                  <span class="cp-live-dot" aria-hidden="true"></span>
                  <p class="codepixel-badge-label">{data.badge.label}</p>
                </div>
              </div>
            )
          }
          <!-- TITLE -->
          <h1 id="hero-title" class="hero-text mb-4">
            <span set:html={markdownify(data.title).__html} />
            {
              rotatingWords.length > 0 && (
                <span class="cp-rotator-line">
                  {rotatingPrefix && <span>{rotatingPrefix} </span>}
                  <span class="cp-rotator" data-rotator>
                    {rotatingWords.map((word, i) => (
                      <span
                        class:list={[
                          "cp-rotator-word heading-script-accent",
                          { "is-active": i === 0 },
                        ]}
                        aria-hidden={i === 0 ? undefined : "true"}
                      >
                        {word}
                      </span>
                    ))}
                  </span>
                </span>
              )
            }
          </h1>
          <!-- CONTENT -->
          <p id="hero-content" class="text-lg sm:w-3/5">
            {data.content}
          </p>
          <!-- BUTTONS -->
          <div
            id="hero-buttons"
            class="mt-10 flex items-center gap-5 flex-wrap justify-center"
          >
            {
              data.button_dark?.enable && (
                <AnimatedButton
                  classNames="btn btn-dark"
                  href={data.button_dark?.link || "/"}
                >
                  {data.button_dark?.label}
                </AnimatedButton>
              )
            }
            {
              data.button_primary?.enable && (
                <AnimatedButton
                  classNames="btn btn-primary"
                  href={data.button_primary?.link || "/"}
                >
                  {data.button_primary?.label}
                </AnimatedButton>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================
     TITELBILD – Hintergrund
     ========================================================= */
  .cp-hero {
    isolation: isolate;
  }

  .cp-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Pixel-Feld (Canvas) – Mitte bleibt ruhig, damit der Text gut lesbar ist */
  .cp-hero-pixels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(ellipse 46% 52% at 50% 46%, transparent 0%, transparent 38%, #000 82%);
    mask-image: radial-gradient(ellipse 46% 52% at 50% 46%, transparent 0%, transparent 38%, #000 82%);
    opacity: 0.95;
  }

  /* Feines Raster */
  .cp-hero-grid {
    position: absolute;
    inset: -2px;
    background-image:
      linear-gradient(rgba(255, 152, 0, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 152, 0, 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 40%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 75% 70% at 50% 40%, #000 20%, transparent 78%);
    animation: cpGridDrift 18s linear infinite;
  }

  /* Leuchtende Farbwolken in Codepixel-Farben */
  .cp-hero-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(90px);
    mix-blend-mode: screen;
    will-change: transform;
  }
  .cp-hero-glow--a {
    width: 46rem;
    height: 22rem;
    left: 50%;
    top: 8%;
    margin-left: -23rem;
    background: radial-gradient(closest-side, rgba(255, 152, 0, 0.38), transparent);
    animation: cpGlowA 14s ease-in-out infinite;
  }
  .cp-hero-glow--b {
    width: 26rem;
    height: 26rem;
    left: -6rem;
    bottom: -8rem;
    background: radial-gradient(closest-side, rgba(255, 208, 0, 0.22), transparent);
    animation: cpGlowB 17s ease-in-out infinite;
  }
  .cp-hero-glow--c {
    width: 30rem;
    height: 24rem;
    right: -8rem;
    top: 18%;
    background: radial-gradient(closest-side, rgba(243, 106, 0, 0.26), transparent);
    animation: cpGlowC 20s ease-in-out infinite;
  }

  /* Lichtstrahl, der langsam über das Bild wandert */
  .cp-hero-beam {
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 22%;
    left: -30%;
    background: linear-gradient(90deg, transparent, rgba(255, 208, 0, 0.07), transparent);
    transform: skewX(-18deg);
    animation: cpBeam 9s cubic-bezier(0.45, 0, 0.25, 1) infinite;
  }

  /* Licht folgt der Maus */
  .cp-hero-spot {
    position: absolute;
    width: 34rem;
    height: 34rem;
    left: 0;
    top: 0;
    margin: -17rem 0 0 -17rem;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(255, 173, 22, 0.13), transparent);
    transform: translate3d(50vw, 40%, 0);
    transition: opacity 0.6s ease;
    opacity: 0;
  }
  .cp-hero-spot.is-on {
    opacity: 1;
  }

  /* Leuchtende Horizontlinie unten */
  .cp-hero-horizon {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(70rem, 92%);
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(255, 152, 0, 0.7), rgba(255, 208, 0, 0.95), rgba(255, 152, 0, 0.7), transparent);
    box-shadow: 0 0 22px 2px rgba(255, 152, 0, 0.35);
  }
  .cp-hero-horizon::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 60%;
    height: 9rem;
    transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 100% at 50% 100%, rgba(255, 152, 0, 0.16), transparent 70%);
  }

  /* =========================================================
     Schwebende Karten
     ========================================================= */
  .cp-float-layer {
    display: none;
  }

  @media (min-width: 1400px) {
    .cp-float-layer {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
  }

  .cp-float {
    position: absolute;
    opacity: 0;
    animation:
      cpFloatIn 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards,
      cpFloat 7s ease-in-out infinite;
    animation-delay: 1s, var(--fd);
  }
  .cp-float--site { left: -3.5rem; top: 1.5rem; width: 11.25rem; transform: rotate(-4deg); }
  .cp-float--chart { right: -3.5rem; top: 2rem; width: 11.25rem; transform: rotate(3deg); }
  .cp-float--code { left: -2.5rem; bottom: 4.5rem; width: 13.5rem; transform: rotate(3deg); }
  .cp-float--steps { right: -2rem; bottom: 4rem; width: 11.5rem; transform: rotate(-3deg); }

  .cp-float--site,
  .cp-float--chart { animation-delay: 1.1s, var(--fd); }
  .cp-float--code,
  .cp-float--steps { animation-delay: 1.35s, var(--fd); }

  .cp-fcard {
    position: relative;
    padding: 0.85rem 0.95rem;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(23, 16, 6, 0.88), rgba(9, 10, 13, 0.92));
    border: 1px solid rgba(255, 152, 0, 0.22);
    box-shadow:
      0 18px 50px -18px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.02) inset,
      0 0 34px -12px rgba(255, 152, 0, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.78rem;
    color: #fff8e8;
    text-align: left;
  }
  .cp-fcard::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(130deg, rgba(255, 208, 0, 0.75), transparent 40%, transparent 65%, rgba(255, 152, 0, 0.55));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Karte 1 – Mini-Webseite */
  .cp-fbar {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 0.6rem;
  }
  .cp-fbar span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #3a2a12;
  }
  .cp-fbar span:first-child { background: #ff9800; }
  .cp-fbar em {
    margin-left: 0.4rem;
    font-style: normal;
    font-size: 0.66rem;
    color: #a6a6aa;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
  }
  .cp-fsite {
    display: grid;
    gap: 6px;
    padding: 0.55rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
  }
  .cp-fsk {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, #ff9800, #ffd000);
    transform-origin: left;
    animation: cpSkeleton 4.5s ease-in-out infinite;
  }
  .cp-fsk.w90 { width: 90%; }
  .cp-fsk.w60 { width: 60%; opacity: 0.45; animation-delay: 0.25s; }
  .cp-fsite-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    margin-top: 3px;
  }
  .cp-fsite-row b {
    height: 22px;
    border-radius: 6px;
    background: rgba(255, 152, 0, 0.12);
    border: 1px solid rgba(255, 152, 0, 0.18);
    animation: cpPop 4.5s ease-in-out infinite;
  }
  .cp-fsite-row b:nth-child(2) { animation-delay: 0.15s; }
  .cp-fsite-row b:nth-child(3) { animation-delay: 0.3s; }
  .cp-fstatus {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.65rem;
    font-weight: 600;
    color: #fff8e8;
  }
  .cp-fcheck {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    font-size: 0.65rem;
    color: #050608;
    background: linear-gradient(135deg, #ffd000, #ff9800);
    box-shadow: 0 0 12px rgba(255, 208, 0, 0.6);
  }

  /* Karte 2 – Kurve */
  .cp-flabel {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a6a6aa;
  }
  .cp-fvalue {
    margin-top: 0.15rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff8e8;
  }
  .cp-fvalue span {
    color: #ffd000;
    text-shadow: 0 0 10px rgba(255, 208, 0, 0.7);
  }
  .cp-fspark {
    display: block;
    width: 100%;
    height: 56px;
    margin-top: 0.45rem;
    overflow: visible;
  }
  .cp-fspark-line {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: cpDraw 5s ease-in-out infinite;
    filter: drop-shadow(0 0 4px rgba(255, 173, 22, 0.8));
  }
  .cp-fspark-area {
    animation: cpAreaFade 5s ease-in-out infinite;
  }
  .cp-fspark-dot {
    animation: cpDotPulse 5s ease-in-out infinite;
    filter: drop-shadow(0 0 6px rgba(255, 208, 0, 1));
  }

  /* Karte 3 – Code */
  .cp-fcard--code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.7rem;
    line-height: 1.75;
    color: #f8f6f1;
  }
  .cp-fcard--code b { color: #ff9800; font-weight: 600; }
  .cp-fcard--code u { color: #ffd000; text-decoration: none; }
  .cp-fcomment {
    color: #a6a6aa;
    display: flex;
    align-items: center;
  }
  .cp-fcaret {
    display: inline-block;
    width: 6px;
    height: 12px;
    margin-left: 4px;
    background: #ffd000;
    animation: cpCaret 1s steps(1) infinite;
  }

  /* Karte 4 – Schritte */
  .cp-fsteps {
    margin-top: 0.55rem;
    display: grid;
    gap: 0.4rem;
  }
  .cp-fsteps li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #a6a6aa;
  }
  .cp-fsteps li span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 1.5px solid #3a2a12;
  }
  .cp-fsteps li.done { color: #fff8e8; }
  .cp-fsteps li.done span {
    border-color: transparent;
    background: linear-gradient(135deg, #ffd000, #ff9800);
  }
  .cp-fsteps li.run { color: #ffd000; font-weight: 600; }
  .cp-fsteps li.run span {
    border-color: #ffd000;
    background: #ffd000;
    animation: cpRunDot 1.6s ease-out infinite;
  }

  /* =========================================================
     Badge & Titel (bestehend)
     ========================================================= */
  .codepixel-badge-label {
    padding: 0.05rem 1rem 0.05rem 0;
    color: #ffd000;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .cp-live-dot {
    width: 8px;
    height: 8px;
    margin-left: 0.85rem;
    border-radius: 999px;
    background: #ffd000;
    animation: cpHeroPing 2s ease-out infinite;
  }

  /* Farbiger Verlauf für markierte Wörter (z. B. ==Kunden==) */
  #hero-title :global(mark:not(.heading-script-accent)) {
    color: transparent;
    background: linear-gradient(110deg, #ffd000 0%, #ff9800 58%, #f36a00 100%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  #hero-title,
  #hero-content {
    text-shadow: 0 2px 24px rgba(5, 6, 8, 0.85);
  }

  /* ---------- Wechselnde Wörter in Schnürlischrift ---------- */
  .cp-rotator-line {
    display: block;
    margin-top: 0.3em;
  }

  .cp-rotator {
    display: inline-grid;
    vertical-align: baseline;
    text-align: left;
  }

  .cp-rotator-word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: rotate(-2deg) translateY(0.45em);
    filter: blur(6px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.55s ease;
  }

  .cp-rotator-word.is-active {
    opacity: 1;
    transform: rotate(-2deg) translateY(0.04em);
    filter: blur(0);
  }

  .cp-rotator-word.is-leaving {
    opacity: 0;
    transform: rotate(-2deg) translateY(-0.45em);
    filter: blur(6px);
  }

  /* Handy: Wort steht unter "Mit" und bricht nie über den Rand */
  @media (max-width: 640px) {
    .cp-rotator-line {
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 100%;
    }

    .cp-rotator {
      text-align: center;
      max-width: 100%;
    }

    .cp-rotator-word {
      font-size: 1.15em;
      white-space: normal;
      text-align: center;
    }

    .cp-hero-glow--a {
      width: 26rem;
      margin-left: -13rem;
    }

    .cp-hero-pixels {
      -webkit-mask-image: radial-gradient(ellipse 70% 40% at 50% 45%, transparent 30%, #000 90%);
      mask-image: radial-gradient(ellipse 70% 40% at 50% 45%, transparent 30%, #000 90%);
      opacity: 0.7;
    }
  }

  /* =========================================================
     Animationen (laufen immer)
     ========================================================= */
  @keyframes cpHeroPing {
    0% { box-shadow: 0 0 0 0 rgba(255, 208, 0, 0.6); }
    100% { box-shadow: 0 0 0 9px rgba(255, 208, 0, 0); }
  }
  @keyframes cpGridDrift {
    from { background-position: 0 0, 0 0; }
    to { background-position: 0 44px, 44px 0; }
  }
  @keyframes cpGlowA {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(3rem, 1.5rem, 0) scale(1.12); }
  }
  @keyframes cpGlowB {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(5rem, -3rem, 0); }
  }
  @keyframes cpGlowC {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(-4rem, 3rem, 0) scale(0.9); }
  }
  @keyframes cpBeam {
    0% { left: -30%; }
    70%, 100% { left: 120%; }
  }
  @keyframes cpFloatIn {
    from { opacity: 0; translate: 0 26px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes cpFloat {
    0%, 100% { margin-top: 0; margin-left: 0; }
    50% { margin-top: -14px; margin-left: var(--fx); }
  }
  @keyframes cpSkeleton {
    0% { transform: scaleX(0.1); }
    35%, 85% { transform: scaleX(1); }
    100% { transform: scaleX(0.1); }
  }
  @keyframes cpPop {
    0%, 15% { opacity: 0.2; transform: translateY(4px); }
    35%, 85% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0.2; transform: translateY(4px); }
  }
  @keyframes cpDraw {
    0% { stroke-dashoffset: 220; }
    45%, 85% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -220; }
  }
  @keyframes cpAreaFade {
    0%, 15% { opacity: 0; }
    50%, 85% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cpDotPulse {
    0%, 40% { opacity: 0; r: 2; }
    50% { opacity: 1; r: 5; }
    60%, 85% { opacity: 1; r: 3.5; }
    100% { opacity: 0; }
  }
  @keyframes cpCaret {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  @keyframes cpRunDot {
    0% { box-shadow: 0 0 0 0 rgba(255, 208, 0, 0.7); }
    100% { box-shadow: 0 0 0 7px rgba(255, 208, 0, 0); }
  }
</style>

<script>
  import { animateMini as animate } from "motion";

  function initHero() {
    const smooth = { ease: "easeInOut" as const };
    const items: [string, Record<string, string[]>, number, number][] = [
      ["hero-badge", { opacity: ["0", "1"], transform: ["translateY(-20px)", "translateY(0)"] }, 0.5, 0.2],
      ["hero-title", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.8, 0.3],
      ["hero-content", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.5],
      ["hero-buttons", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.6],
    ];
    items.forEach(([id, keyframes, duration, delay]) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.opacity = "0";
      animate(el, keyframes, { ...smooth, duration, delay });
    });
  }

  let rotatorTimer: number | undefined;

  function initRotator() {
    window.clearInterval(rotatorTimer);
    const rotator = document.querySelector<HTMLElement>("[data-rotator]");
    if (!rotator) return;
    const words = Array.from(
      rotator.querySelectorAll<HTMLElement>(".cp-rotator-word"),
    );
    if (words.length < 2) return;
    let index = 0;
    rotatorTimer = window.setInterval(() => {
      const current = words[index];
      index = (index + 1) % words.length;
      const next = words[index];
      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      current.setAttribute("aria-hidden", "true");
      next.classList.remove("is-leaving");
      next.classList.add("is-active");
      next.removeAttribute("aria-hidden");
      window.setTimeout(() => current.classList.remove("is-leaving"), 600);
    }, 2400);
  }

  /* ---------- Pixel-Feld: Pixel leuchten in Codepixel-Farben auf ---------- */
  let pixelCleanup: (() => void) | undefined;

  function initPixels() {
    pixelCleanup?.();
    const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-pixels]");
    const section = canvas?.closest<HTMLElement>(".cp-hero");
    const spot = document.querySelector<HTMLElement>("[data-hero-spot]");
    if (!canvas || !section) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const COLORS = ["255,152,0", "255,208,0", "255,173,22", "243,106,0"];
    const CELL = 22;
    const GAP = 3;
    let w = 0;
    let h = 0;
    let cols = 0;
    let rows = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;
    let mouseX = -9999;
    let mouseY = -9999;

    type Px = { c: number; r: number; life: number; max: number; color: string; peak: number };
    let pixels: Px[] = [];

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = section.clientWidth;
      h = section.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(w / CELL);
      rows = Math.ceil(h / CELL);
    };

    const spawn = (c?: number, r?: number, strong = false): Px => ({
      c: c ?? Math.floor(Math.random() * cols),
      r: r ?? Math.floor(Math.random() * rows),
      life: 0,
      max: strong ? 50 + Math.random() * 30 : 90 + Math.random() * 160,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      peak: strong ? 0.9 : 0.15 + Math.random() * 0.45,
    });

    const target = () => Math.round((cols * rows) / (w < 640 ? 40 : 26));

    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // Ruhige Grund-Pixel
      ctx.fillStyle = "rgba(255,152,0,0.035)";
      for (let r = 0; r < rows; r += 1) {
        for (let c = (r % 2); c < cols; c += 2) {
          ctx.fillRect(c * CELL + GAP, r * CELL + GAP, CELL - GAP * 2, CELL - GAP * 2);
        }
      }

      while (pixels.length < target()) pixels.push(spawn());

      // Pixel in der Nähe der Maus leuchten auf
      if (mouseX > -1000 && Math.random() < 0.55) {
        const c = Math.floor((mouseX + (Math.random() - 0.5) * 160) / CELL);
        const r = Math.floor((mouseY + (Math.random() - 0.5) * 160) / CELL);
        if (c >= 0 && r >= 0 && c < cols && r < rows) pixels.push(spawn(c, r, true));
      }

      pixels = pixels.filter((p) => {
        p.life += 1;
        const t = p.life / p.max;
        if (t >= 1) return false;
        const a = Math.sin(t * Math.PI) * p.peak;
        const x = p.c * CELL + GAP;
        const y = p.r * CELL + GAP;
        const s = CELL - GAP * 2;
        ctx.fillStyle = `rgba(${p.color},${a.toFixed(3)})`;
        ctx.fillRect(x, y, s, s);
        if (a > 0.6) {
          ctx.shadowColor = `rgba(${p.color},${a.toFixed(3)})`;
          ctx.shadowBlur = 14;
          ctx.fillRect(x + 2, y + 2, s - 4, s - 4);
          ctx.shadowBlur = 0;
        }
        return true;
      });

      if (visible) raf = requestAnimationFrame(draw);
    };

    const onMove = (e: PointerEvent) => {
      const rect = section.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      if (spot) {
        spot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
        spot.classList.add("is-on");
      }
    };
    const onLeave = () => {
      mouseX = -9999;
      mouseY = -9999;
      spot?.classList.remove("is-on");
    };

    const io = new IntersectionObserver(([entry]) => {
      const was = visible;
      visible = entry.isIntersecting;
      if (visible && !was) raf = requestAnimationFrame(draw);
      if (!visible) cancelAnimationFrame(raf);
    });

    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(section);
    io.observe(section);
    section.addEventListener("pointermove", onMove);
    section.addEventListener("pointerleave", onLeave);
    raf = requestAnimationFrame(draw);

    pixelCleanup = () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      section.removeEventListener("pointermove", onMove);
      section.removeEventListener("pointerleave", onLeave);
    };
  }

  document.addEventListener("astro:page-load", () => {
    initHero();
    initRotator();
    initPixels();
  });
</script>
